# Copy to .env and fill in. .env is gitignored.

# --- App ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production

# --- Database (raw SQL via psycopg; matches docker-compose) ---
# Plain libpq URL (NOT the SQLAlchemy "+psycopg" form).
DATABASE_URL=postgresql://student:student@localhost:5432/student_journey

# --- LLM (Ollama Cloud) ---
# A single API key for now; the key-rotation service is merged in later.
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=
# Multiple models, cost/size-tiered (override with the exact tags your key serves)
LLM_MODEL_CHEAP=gpt-oss:20b
LLM_MODEL_DEFAULT=gpt-oss:120b
LLM_MODEL_SMART=deepseek-v3.1:671b

# --- Embeddings (RAG) ---
# Ollama Cloud does NOT serve embedding models (/api/embed returns 401), so
# embeddings run on a separate local/self-hosted Ollama. Pull the model first:
#   ollama pull nomic-embed-text
# OLLAMA_EMBED_API_KEY is optional (a local server needs none).
OLLAMA_EMBED_HOST=http://localhost:11434
OLLAMA_EMBED_API_KEY=
# 768-dim; must match the vector(N) column in 0003_phase2_study_material.sql
LLM_MODEL_EMBED=nomic-embed-text

# --- Web search providers [searxng | tavily | duckduckgo] ---
# searxng: self-hosted metasearch (free, no key) — runs via docker compose, also
#          provides YouTube video/playlist results. DuckDuckGo is the keyless
#          fallback; Tavily (paid) gives LLM-grade content extraction.
SEARCH_PROVIDER=searxng
SEARXNG_URL=http://localhost:8080
TAVILY_API_KEY=

# --- jwt ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60*24